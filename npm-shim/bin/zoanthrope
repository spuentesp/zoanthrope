#!/usr/bin/env node
// Thin launcher: forwards argv to the zoanthrope binary. No download
// machinery — point ZOANTHROPE_BIN at the binary or keep it on PATH.
'use strict';

const { spawn } = require('child_process');

const binary = process.env.ZOANTHROPE_BIN || 'zoanthrope';
const child = spawn(binary, process.argv.slice(2), {
  stdio: 'inherit',
  windowsHide: true,
});

child.on('error', (error) => {
  process.stderr.write(
    `zoanthrope shim: could not start '${binary}': ${error.message}\n` +
      'Set ZOANTHROPE_BIN to the binary path, or install it (cargo install --path .)\n'
  );
  process.exit(1);
});

child.on('exit', (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal);
    return;
  }
  process.exit(code == null ? 1 : code);
});
